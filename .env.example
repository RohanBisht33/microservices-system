# Root docker-compose configuration
NODE_ENV=development

# Postgres databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USER_DB_NAME=user_service_db
NOTIFICATION_DB_NAME=notification_service_db

# NATS JetStream configuration
NATS_URL=nats://nats:4222
NATS_AUTH_TOKEN=dev_nats_token_sec_123
NATS_TLS_CA_PATH=./nats/certs/ca.crt

# Service ports
GATEWAY_PORT=3000
USER_SERVICE_PORT=4001
NOTIFICATION_SERVICE_PORT=4002

# Internal Service URLs
USER_SERVICE_URL=http://user-service:4001
NOTIFICATION_SERVICE_URL=http://notification-service:4002

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
